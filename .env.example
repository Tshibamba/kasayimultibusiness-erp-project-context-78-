# ─────────────────────────────────────────────────────────────
# KasayiMultiBusiness ERP — Variables d'environnement
# Copiez ce fichier : cp .env.example .env
# Puis modifiez les valeurs selon votre configuration
# ─────────────────────────────────────────────────────────────

# Base de données PostgreSQL (OBLIGATOIRE)
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kasayi_erp

# Clé secrète pour les sessions (OBLIGATOIRE en production)
# Génère une clé aléatoire : openssl rand -base64 32
SESSION_SECRET=changez-cette-cle-secrete-en-production

# Environnement
NODE_ENV=development

# Port du serveur (optionnel, défaut 3000)
PORT=3000

# ─────────────────────────────────────────────────────────────
# Paramètres optionnels (valeurs par défaut dans le code)
# ─────────────────────────────────────────────────────────────

# Email SMTP (pour notifications, optionnel)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre.email@gmail.com
# SMTP_PASS=mot_de_passe_application

# ─────────────────────────────────────────────────────────────
# IA — Clés API fournisseurs (au moins une requise pour l'IA réelle)
# Sans clé : l'assistant fonctionne en mode démo (réponses simulées)
# Obtenir Gemini gratuit : https://aistudio.google.com/apikey
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
OLLAMA_HOST=http://localhost:11434
